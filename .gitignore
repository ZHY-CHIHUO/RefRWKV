# Python and build products
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Local datasets: keep loaders and Markdown notes, ignore downloaded/generated data.
/data/raw/
/data/archives/
/data/**/[Hh][Rr]/*.png
/data/**/[Hh][Rr]/*.jpg
/data/**/[Hh][Rr]/*.jpeg
/data/**/[Hh][Rr]/*.tif
/data/**/[Hh][Rr]/*.tiff
/data/**/[Ll][Rr]/*.png
/data/**/[Ll][Rr]/*.jpg
/data/**/[Ll][Rr]/*.jpeg
/data/**/[Ll][Rr]/*.tif
/data/**/[Ll][Rr]/*.tiff
/data/**/[Rr][Ee][Ff]/*.png
/data/**/[Rr][Ee][Ff]/*.jpg
/data/**/[Rr][Ee][Ff]/*.jpeg
/data/**/[Rr][Ee][Ff]/*.tif
/data/**/[Rr][Ee][Ff]/*.tiff
/data/**/*.png
/data/**/*.jpg
/data/**/*.jpeg
/data/**/*.tif
/data/**/*.tiff
# Wuhan temporal-pair TIFFs live in a dataset-specific directory and are
# intentionally kept out of git while the accompanying loader/config remain
# versioned.
/data/refsr/Wuhan-dataset/**/*.tif
/data/refsr/Wuhan-dataset/**/*.tiff
/data/**/*.npy
/data/**/manifest.jsonl
/data/**/metadata.json
!/data/refsr/Wuhan-dataset/metadata.json
!/data/refsr/Wuhan-dataset/SPLIT_MANIFEST.md
!/data/refsr/Wuhan-dataset/split_manifest.json

# Model weights and generated image/log artifacts are local files. Experiment
# metadata, metrics, configs, and comparison reports remain versioned so runs
# can be inspected without committing large binary outputs.
/weights/*
!/weights/.gitkeep
!/weights/README.md

/experiments/**/images/
/experiments/**/checkpoints/
/experiments/**/logs/
/experiments/**/*.png
/experiments/**/*.jpg
/experiments/**/*.jpeg
/experiments/**/*.webp
/experiments/**/*.bmp
/experiments/**/*.tif
/experiments/**/*.tiff
/experiments/**/*.ckpt
/experiments/**/*.pt
/experiments/**/*.pth
/experiments/**/*.safetensors
/experiments/**/*.bin
/experiments/**/*.log
/experiments/**/events.out.tfevents.*

# Optional derived LR cache. Native loaders derive non-storage scales in RAM,
# so this remains empty unless an experiment explicitly enables a cache.
/cache/

# CUDA and native compilation products
*.o
*.out
*.ptx
*.cu.o

# Local environment and IDE files
.env
.env.local
.vscode/
.idea/
.DS_Store
Thumbs.db
