# Python and build products
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Local datasets: keep loaders and Markdown notes, ignore downloaded/generated data.
/data/raw/
/data/archives/
/data/**/[Hh][Rr]/*.png
/data/**/[Hh][Rr]/*.jpg
/data/**/[Hh][Rr]/*.jpeg
/data/**/[Hh][Rr]/*.tif
/data/**/[Hh][Rr]/*.tiff
/data/**/[Ll][Rr]/*.png
/data/**/[Ll][Rr]/*.jpg
/data/**/[Ll][Rr]/*.jpeg
/data/**/[Ll][Rr]/*.tif
/data/**/[Ll][Rr]/*.tiff
/data/**/[Rr][Ee][Ff]/*.png
/data/**/[Rr][Ee][Ff]/*.jpg
/data/**/[Rr][Ee][Ff]/*.jpeg
/data/**/[Rr][Ee][Ff]/*.tif
/data/**/[Rr][Ee][Ff]/*.tiff
/data/**/*.png
/data/**/*.jpg
/data/**/*.jpeg
/data/**/*.tif
/data/**/*.tiff
/data/**/*.npy
/data/**/manifest.jsonl
/data/**/metadata.json

# Model weights and run outputs are local artifacts.
/weights/*
!/weights/.gitkeep
!/weights/README.md
/experiments/*
!/experiments/.gitkeep

# Optional derived LR cache. Native loaders derive non-storage scales in RAM,
# so this remains empty unless an experiment explicitly enables a cache.
/cache/

# CUDA and native compilation products
*.o
*.out
*.ptx
*.cu.o

# Local environment and IDE files
.env
.env.local
.vscode/
.idea/
.DS_Store
Thumbs.db
